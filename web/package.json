{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-data.mjs && node scripts/year-summaries.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-data.mjs && node scripts/year-summaries.mjs",
    "build": "node scripts/check-tokens.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "node scripts/check-tokens.mjs && node scripts/check-css.mjs && node scripts/check-bundle.mjs",
    "seo-check": "node scripts/seo-check.mjs dist https://satory074.github.io/m1-omoroi/ --require-backlink"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
